# Copy to .env and fill in.  .env is git-ignored — never commit real keys.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# govinfo.gov API key (https://api.data.gov/signup/)
GOVINFO_API_KEY=

# Optional: point the pipeline at data stored outside the repo
# (e.g. a shared drive). Defaults to <repo>/data when unset.
# THESIS_DATA_DIR=
